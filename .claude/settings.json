{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr checkout:*)",
      "Bash(uv sync:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pytest:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh issue close:*)",
      "Bash(gh pr close:*)",
      "Bash(gh release:*)",
      "Bash(git branch -d:*)",
      "Bash(gh pr merge:*)",
      "Edit(./.github/workflows/**)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git branch -D:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh release delete:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(reg:*)",
      "Bash(reg.exe:*)",
      "PowerShell(Remove-Item -Recurse:*)",
      "PowerShell(Set-ItemProperty:*)",
      "PowerShell(Format-Volume:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.claude/settings.json)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/agents/**)"
    ]
  }
}
